diff --git a/run_megamind_windows.bat b/run_megamind_windows.bat
new file mode 100644
index 0000000..172c87e
--- /dev/null
+++ b/run_megamind_windows.bat
@@ -0,0 +1,7 @@
+@echo off
+REM Megamind Studios - launch. Run setup_megamind_windows.bat once first.
+REM Line-ending safe: single-line conditionals only, no labels.
+cd /d %~dp0
+if not exist venv\Scripts\python.exe ( echo [Megamind] Setup not done yet. Run setup_megamind_windows.bat first. & pause & exit /b 1 )
+venv\Scripts\python wgp.py
+pause
