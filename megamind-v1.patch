diff --git a/megamind/curate_models.py b/megamind/curate_models.py
new file mode 100644
index 0000000..cd5ed1c
--- /dev/null
+++ b/megamind/curate_models.py
@@ -0,0 +1,25 @@
+# Megamind Studios - model list curation.
+# Writes finetunes/<model_type>.json stubs {"model":{"visible":false}} for every
+# model in defaults/ that is not on the Megamind allowlist. Upstream-supported
+# mechanism: refresh_model_defs() in wgp.py merges these over the defaults and
+# displays only models whose model_def has "visible" != false.
+# Re-run after any WanGP upstream update (new defaults get hidden by default).
+import glob, json, os
+
+ALLOWLIST = {"ti2v_2_2", "qwen_image_20B", "chatterbox", "ace_step_v1_5"}
+# H3 (MiniMax) deliberately NOT included: its license restricts display of
+# outputs outside its territory (excludes US/EU/UK/SK) - pending owner decision.
+
+root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+os.makedirs(os.path.join(root, "finetunes"), exist_ok=True)
+written = kept = 0
+for path in glob.glob(os.path.join(root, "defaults", "*.json")):
+    model_type = os.path.basename(path)[:-5]
+    if model_type in ALLOWLIST:
+        kept += 1
+        continue
+    stub = os.path.join(root, "finetunes", model_type + ".json")
+    with open(stub, "w", encoding="utf-8") as f:
+        json.dump({"model": {"visible": False}}, f, indent=2)
+    written += 1
+print(f"Megamind curation: {written} models hidden, {kept} kept visible: {sorted(ALLOWLIST)}")
